# Open/free default provider (works offline with deterministic planning)
USETAI_PROVIDER=heuristic
USETAI_MAX_STEPS=4

# Tool feature flags
USETAI_ENABLE_DOCS_TOOL=true
USETAI_ENABLE_WEB_TOOL=true
USETAI_DOCS_PATHS=README.md,docs

# Optional local OSS model runtime via Ollama
USETAI_OLLAMA_BASE_URL=http://localhost:11434
USETAI_OLLAMA_MODEL=llama3.1:8b

# Optional Hugging Face inference (only used when USETAI_PROVIDER=hf_inference)
USETAI_HF_MODEL=google/flan-t5-small
USETAI_HF_API_TOKEN=

# Output
USETAI_HISTORY_FILE=history.json
